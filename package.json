{
  "name": "rikuy",
  "version": "0.25.0",
  "private": true,
  "description": "A LaTeX editor in the browser where you type on the typeset page, with TeX Live 2026 running in a Web Worker",
  "license": "AGPL-3.0-or-later",
  "author": "Pedro F. Rackebrandt",
  "homepage": "https://github.com/pdfrackebrandt/rikuy#readme",
  "bugs": "https://github.com/pdfrackebrandt/rikuy/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/pdfrackebrandt/rikuy.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "serve": "python3 test/serve.py 8790",
    "test": "node test/model.test.mjs && node test/edge.test.mjs && node test/fences.test.mjs && node test/minimal.test.mjs && node test/siunitx.test.mjs && node test/share.test.mjs && node test/gitauth.test.mjs && node --no-experimental-fetch tex/native/xindy/test.cjs",
    "test:corpus": "node test/corpus.test.mjs",
    "test:engines": "cd test && python3 engines.py",
    "test:browser": "cd test && python3 browser.py"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.10.3",
    "@okathira/ghostpdl-wasm": "^1.1.0",
    "buffer": "^6.0.3",
    "codemirror": "^5.65.16",
    "computer-modern": "^0.1.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "isomorphic-git": "^1.43.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "mathlive": "0.110.0",
    "pdfjs-dist": "^4.10.38",
    "pyodide": "^314.0.7"
  }
}
